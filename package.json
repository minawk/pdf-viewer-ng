{
  "name": "pdf-viewer-ng",
  "version": "0.2.2",
  "author": "minawk",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build:lib && ng build demo",
    "build:lib": "ng build pdf-viewer-ng && tsc -p projects/pdf-viewer-ng/tsconfig.schematics.json",
    "watch:lib": "ng build pdf-viewer-ng --watch --configuration development",
    "test": "ng test pdf-viewer-ng --watch=false",
    "e2e": "playwright test",
    "publish:lib": "npm run build:lib && npm publish ./dist/minawk/pdf-viewer-ng",
    "test:schematics": "npm run build:lib && tsc -p projects/pdf-viewer-ng/tsconfig.schematics.spec.json && node --test out-tsc/schematics/ng-add/index.spec.js",
    "build:pages": "ng build demo --base-href /pdf-viewer-ng/"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.7",
    "@angular-devkit/schematics": "~22.2.7",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@schematics/angular": "~22.2.7",
    "@types/node": "^24.19.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
