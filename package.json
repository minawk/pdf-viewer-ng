{
  "name": "pdf-viewer-ng",
  "version": "0.0.1",
  "author": "minawk",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build pdf-viewer-ng && ng build demo",
    "build:lib": "ng build pdf-viewer-ng",
    "watch:lib": "ng build pdf-viewer-ng --watch --configuration development",
    "test": "ng test pdf-viewer-ng --watch=false",
    "e2e": "playwright test",
    "publish:lib": "ng build pdf-viewer-ng && npm publish ./dist/minawk/pdf-viewer-ng"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
